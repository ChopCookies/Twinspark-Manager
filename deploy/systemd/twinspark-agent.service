[Unit]
Description=TwinSpark agent (typed container/runtime actions)
After=network-online.target docker.service twinspark-privd.service
Wants=network-online.target docker.service

[Service]
User=twinspark
SupplementaryGroups=docker twinspark
ExecStart=/opt/twinspark/venv/bin/tsm serve agent --config /etc/twinspark/agent.yaml
Restart=on-failure
RestartSec=3
# lightweight, and never the OOM victim before vLLM
MemoryMax=512M
OOMScoreAdjust=-500
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/twinspark /etc/twinspark/secrets /var/cache/twinspark /var/lib/twinspark/hf-cache
PrivateTmp=true

[Install]
WantedBy=multi-user.target

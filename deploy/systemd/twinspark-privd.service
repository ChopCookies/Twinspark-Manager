[Unit]
Description=TwinSpark privileged helper (drop page cache, headless mode, node power)
After=local-fs.target

[Service]
Type=simple
ExecStart=/opt/twinspark/venv/bin/tsm serve privd --socket /run/twinspark/privd.sock --group twinspark --remote-policy /etc/twinspark/remote-policy.json
Restart=on-failure
User=root
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

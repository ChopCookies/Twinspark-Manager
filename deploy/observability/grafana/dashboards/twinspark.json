      "type": "timeseries",
      "title": "TTFT p50 / p95",
      "datasource": {
        "type": "prometheus",
        "uid": "twinspark-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 9

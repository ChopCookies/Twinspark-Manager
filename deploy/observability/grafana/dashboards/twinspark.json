{
  "uid": "twinspark",
  "title": "TwinSpark",
  "tags": [
    "twinspark",
    "dgx-spark",
    "vllm"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Serving",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Decode tokens/s",
      "datasource": {
        "type": "prometheus",
        "uid": "twinspark-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "twinspark-prometheus"
          },
          "expr": "sum by (alias) (rate(twinspark:generation_tokens_total[1m]))",
          "legendFormat": "{{alias}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",

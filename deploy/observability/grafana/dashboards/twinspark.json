      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "twinspark-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, alias) (rate(twinspark:time_to_first_token_seconds_bucket[5m])))",
          "legendFormat": "{{alias}} p50"
        },
